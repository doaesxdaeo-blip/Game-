--==================================================
-- CONFIG
--==================================================

local Config = {

    AutoCollect = false,

    AutoRift = false,

    AutoEvent = false,

    Speed = 1600,

    SelectedZones = {},

    SelectedRarities = {},

    SelectedEggs = {}
}


--==================================================
-- RARITY FILTER
--==================================================

local function IsRaritySelected(rarity)

    if next(Config.SelectedRarities) == nil then
        return true
    end

    return Config.SelectedRarities[rarity] == true
end


--==================================================
-- EGG FILTER
--==================================================

local function IsEggSelected(eggName, rarity)

    if not IsRaritySelected(rarity) then
        return false
    end

    if next(Config.SelectedEggs) == nil then
        return true
    end

    return Config.SelectedEggs[eggName] == true
end


--==================================================
-- ZONE FILTER
--==================================================

local function IsZoneSelected(zoneName)

    if next(Config.SelectedZones) == nil then
        return true
    end

    return Config.SelectedZones[zoneName] == true
end


--==================================================
-- FIND TARGETS
--==================================================

local function GetTargets()

    local targets = {}

    for zoneName, zoneData in pairs(EggDatabase.Zones) do

        if IsZoneSelected(zoneName) then

            for _, egg in ipairs(zoneData.Eggs or {}) do

                local eggName = egg[1]
                local rarity = egg[2]

                if IsEggSelected(eggName, rarity) then

                    table.insert(targets, {
                        Zone = zoneName,
                        Egg = eggName,
                        Rarity = rarity,
                        Speed = zoneData.Speed
                    })

                end
            end
        end
    end

    return targets
end


